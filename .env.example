# AWS/GCS 憑證（用於 S3 上傳）
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# 或者使用 GCS 服務帳號
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini API Key（config.py / 各腳本讀取）
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_3=

# X.AI Keys
XAI_API_KEY_1=
XAI_API_KEY_2=

# MongoDB
MONGODB_URI=
